<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>POWtfolio | Your Proof of Work, One Link</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<%- include('partials/nav') %>

<!-- ====== HERO ====== -->
<section class="hero">
  <div class="hero-inner container">
    <div class="hero-eyebrow">
      <span class="dot"></span>
      Your portfolio. Your proof. One link.
    </div>
    <h1 class="hero-title">
      Don't just say you did it.<br>
      <span class="grad-text">Prove it.</span>
    </h1>
    <p class="hero-sub">
      POWtfolio is your Linktree for real work | upload proof of work documents,
      link all your socials, and share everything with one powerful link.
    </p>
    <div class="hero-cta">
      <a href="/auth/register" class="btn btn-primary btn-lg">
        <i class="fas fa-rocket"></i> Create My Profile | Free
      </a>
      <a href="/auth/login" class="btn btn-secondary btn-lg">
        <i class="fas fa-sign-in-alt"></i> Sign In
      </a>
    <a href="/demo" class="btn btn-secondary btn-lg">
      <i class="fas fa-eye"></i> Explore a Demo
    </a>
    </div>
    <div class="hero-roles">
      <span class="hero-role-chip"><i class="fas fa-code"></i> Web Developers</span>
      <span class="hero-role-chip"><i class="fas fa-palette"></i> Designers</span>
      <span class="hero-role-chip"><i class="fas fa-bullhorn"></i> Marketers</span>
      <span class="hero-role-chip"><i class="fas fa-pen-nib"></i> Writers</span>
      <span class="hero-role-chip"><i class="fas fa-video"></i> Video Creators</span>
      <span class="hero-role-chip"><i class="fas fa-camera"></i> Photographers</span>
      <span class="hero-role-chip"><i class="fas fa-music"></i> Musicians</span>
      <span class="hero-role-chip"><i class="fas fa-link"></i> Web3 Builders</span>
    </div>
  </div>
</section>

<!-- ====== PROFILE PREVIEW ====== -->
<section class="showcase-section">
  <div class="container showcase-layout">
    <div class="showcase-copy">
      <p class="section-label">A home for what you make</p>
      <h2 class="section-title">Let your work<br><span class="showcase-script">do the talking.</span></h2>
      <p class="section-sub">One thoughtful page for your projects, proof, skills, and all the places people can find you.</p>
      <a href="/auth/register" class="showcase-link">Build your page <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="showcase-window" aria-label="Example creator portfolio preview">
      <div class="showcase-window-top"><span></span><span></span><span></span><small>powtfolio.site / alex</small></div>
      <div class="showcase-profile">
        <div class="showcase-cover"><span>SELECTED WORK · 2026</span></div>
        <div class="showcase-person"><div class="showcase-avatar">A</div><div><strong>Alex Morgan</strong><small>Product designer · Lagos</small></div><span class="showcase-available"><i></i> Available</span></div>
        <p class="showcase-bio">I turn complex ideas into simple, useful digital experiences.</p>
        <div class="showcase-metrics"><div><b>12</b><small>PROJECTS</small></div><div><b>08</b><small>VERIFIED</small></div><div><b>04</b><small>YEARS MAKING</small></div></div>
        <div class="showcase-projects"><div class="showcase-project-art art-peach"><i class="fas fa-shapes"></i></div><div><b>Fieldnotes | a calmer way to plan</b><small>Product design · Case study</small></div><i class="fas fa-arrow-up-right-from-square"></i></div>
        <div class="showcase-projects"><div class="showcase-project-art art-lilac"><i class="fas fa-layer-group"></i></div><div><b>Making money feel more human</b><small>Fintech · Product strategy</small></div><i class="fas fa-arrow-up-right-from-square"></i></div>
      </div>
    </div>
  </div>
</section>

<!-- ====== HOW IT WORKS ====== -->
<section class="how-section">
  <div class="container">
    <p class="section-label">Easy as it should be</p>
    <h2 class="section-title">From first project to one link.</h2>
    <p class="section-sub">A few small steps. A profile you can share everywhere.</p>
    <div class="steps-grid">
      <div class="step">
        <div class="step-num">1</div>
        <h3>Create your free account</h3>
        <p>Register with a username and get your shareable link instantly | <strong>yourdomain.com/yourname</strong></p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h3>Add your work and socials</h3>
        <p>Upload proof of work documents, add links to GitHub, Instagram, YouTube, Discord, and more.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h3>Share your one link</h3>
        <p>Copy your profile link and put it in your bio, email signature, or send it directly to anyone.</p>
      </div>
    </div>
  </div>
</section>

<!-- ====== FEATURES ====== -->
<section class="features-section">
  <div class="container">
    <p class="section-label">Made for the work behind the work</p>
    <h2 class="section-title">All your good work, in one lovely place.</h2>
    <p class="section-sub">More than a portfolio | verifiable evidence of your skills.</p>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-link"></i></div>
        <h3>One Link for Everything</h3>
        <p>Your socials, your projects, your proof | all under one clean shareable URL that's yours forever.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-file-upload"></i></div>
        <h3>Upload Proof Files</h3>
        <p>Attach images, PDFs, and documents as evidence for every piece of work you add to your portfolio.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-share-alt"></i></div>
        <h3>All Your Socials</h3>
        <p>X, Instagram, TikTok, YouTube, Discord, Telegram, GitHub, LinkedIn, Behance, Dribbble | all connected.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-shield-halved"></i></div>
        <h3>Zero Auth DAO Score</h3>
        <p>Connect your Stacks wallet and display your on-chain Zero Auth DAO reputation score on your profile.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-trophy"></i></div>
        <h3>Earn Reputation</h3>
        <p>Every POW you add earns you reputation points and badges that signal your credibility to employers and clients.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-palette"></i></div>
        <h3>Six Profile Templates</h3>
        <p>Choose a complete layout, then tune the highlight color to fit your personal brand.</p>
      </div>
    </div>
  </div>
</section>

<!-- ====== ABOUT ====== -->
<section class="about-section" id="about">
  <div class="container about-layout">
    <div class="about-mark" aria-hidden="true"><span>POW</span><i class="fas fa-sparkles"></i><small>WORK, WITH RECEIPTS</small></div>
    <div class="about-copy">
      <p class="section-label">A little about us</p>
      <h2 class="section-title">Good work deserves<br>a place of its own.</h2>
      <p>We made POWtfolio for people whose best work is scattered across links, folders, timelines, and old posts. Bring it together into a living portfolio that shows what you made, how you made it, and where to find you.</p>
      <p>From your first project to your next big opportunity, your proof of work belongs to you and travels with one simple link.</p>
      <a href="/auth/register" class="showcase-link">Start building your portfolio <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ====== CTA ====== -->
<section class="cta-section">
  <div class="container">
    <h2>Ready to prove your work?</h2>
    <p>Join creators, builders, and professionals proving their skills every day.</p>
    <a href="/auth/register" class="btn btn-white btn-lg">
      <i class="fas fa-bolt"></i> Create Your Free Profile
    </a>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <img src="/logo.jpg" alt="" class="site-logo-footer">
      POWtfolio
    </div>
    <p>&copy; 2026 POWtfolio. Prove Your Work.</p>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
