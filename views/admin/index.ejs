<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | POWtfolio</title><link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .admin-wrap{max-width:1120px;margin:48px auto;padding:0 22px 64px}.admin-wrap h1{margin-bottom:8px}.admin-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:28px 0 42px}.admin-stat,.review-row,.data-card{padding:22px;border:1px solid #e5e7eb;border-radius:14px;background:#fff}.admin-stat strong{display:block;font-size:2rem}.review-list,.data-list{display:grid;gap:14px}.review-row header,.data-card header{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.review-stars{color:#f0a126}.review-message{white-space:pre-wrap;line-height:1.6}.review-actions{display:flex;gap:10px}.review-actions form{display:inline}.review-actions button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:700}.approve{background:#e6f5ec;color:#176d37}.reject{background:#fff0ee;color:#a33125}.admin-note{padding:12px 16px;margin:18px 0;border-radius:8px;background:#eef4ff}.admin-empty{color:#667085;padding:20px 0}.admin-search{display:flex;gap:10px;margin:20px 0 28px}.admin-search input{flex:1;min-width:0;padding:12px 14px;border:1px solid #d0d5dd;border-radius:8px;font:inherit}.admin-search button{padding:0 20px;border:0;border-radius:8px;background:#252d3a;color:white;font-weight:700}.admin-lists{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:28px 0 44px}.data-card{padding:16px}.data-card p{margin:7px 0;color:#667085}.data-card small{color:#667085}.admin-section-title{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.admin-section-title span{color:#667085;font-size:.86rem}@media(max-width:720px){.admin-lists{grid-template-columns:1fr}}@media(max-width:620px){.admin-stats{grid-template-columns:1fr}.admin-search{flex-wrap:wrap}.admin-search button{min-height:44px}}
  </style>
</head>
<body><main class="admin-wrap">
  <a href="/" class="nav-link">← POWtfolio</a>
  <h1>Review moderation</h1><p>Review pending endorsements and keep public profiles trustworthy.</p>
  <% if (notice) { %><div class="admin-note" role="status"><%= notice === 'approved' ? 'Review approved and published.' : notice === 'rejected' ? 'Review rejected.' : notice === 'missing' ? 'That review was already handled.' : 'Something went wrong. Please try again.' %></div><% } %>
  <section class="admin-stats" aria-label="Platform totals">
    <div class="admin-stat"><span>Total users</span><strong><%= totalUsers %></strong></div>
    <div class="admin-stat"><span>Total proof of work</span><strong><%= totalPOWs %></strong></div>
    <div class="admin-stat"><span>Approved reviews</span><strong><%= approvedReviews %></strong></div>
  </section>
  <h2>Users and proof of work</h2>
  <form class="admin-search" method="get" action="/admin">
    <input type="search" name="q" value="<%= q %>" placeholder="Search users by name, username, or email; search POW by title or skill" aria-label="Search users and proof of work">
    <button type="submit">Search</button>
    <% if (q) { %><a class="nav-link" href="/admin">Clear</a><% } %>
  </form>
  <div class="admin-lists">
    <section><div class="admin-section-title"><h2>Users</h2><span>Showing <%= users.length %><%= totalUsers > users.length ? ' of ' + totalUsers : '' %></span></div>
      <% if (!users.length) { %><p class="admin-empty">No matching users.</p><% } %>
      <div class="data-list"><% users.forEach(account => { %><article class="data-card"><header><strong><%= account.profile.fullName || account.username %></strong><a href="/<%= encodeURIComponent(account.username) %>" target="_blank" rel="noopener">View profile</a></header><p>@<%= account.username %> · <%= account.email %></p><small>Joined <%= new Date(account.createdAt).toLocaleDateString() %></small></article><% }); %></div>
    </section>
    <section><div class="admin-section-title"><h2>POW entries</h2><span>Showing <%= pows.length %><%= totalPOWs > pows.length ? ' of ' + totalPOWs : '' %></span></div>
      <% if (!pows.length) { %><p class="admin-empty">No matching POW entries.</p><% } %>
      <div class="data-list"><% pows.forEach(pow => { %><article class="data-card"><header><strong><%= pow.title %></strong><small><%= pow.type %></small></header><p><%= pow.user ? (pow.user.profile.fullName || pow.user.username) + ' (@' + pow.user.username + ')' : 'Creator unavailable' %></p><small><%= pow.isPublic ? 'Public' : 'Private' %> · Added <%= new Date(pow.createdAt).toLocaleDateString() %></small></article><% }); %></div>
    </section>
  </div>
  <h2>Pending reviews <span>(<%= pendingReviews.length %>)</span></h2>
  <% if (!pendingReviews.length) { %><p class="admin-empty">No reviews need approval right now.</p><% } %>
  <section class="review-list">
    <% pendingReviews.forEach(review => { %>
      <article class="review-row">
        <header><div><strong><%= review.name %></strong> for <a href="/<%= encodeURIComponent(review.subject.username) %>" target="_blank" rel="noopener"><%= review.subject.profile.fullName || review.subject.username %></a>
          <div class="review-stars" aria-label="<%= review.rating %> out of 5 stars"><%= '★'.repeat(review.rating) %><span style="color:#d0d5dd"><%= '★'.repeat(5-review.rating) %></span> <%= review.rating %>/5</div></div>
          <small><%= new Date(review.createdAt).toLocaleString() %></small></header>
        <p class="review-message"><%= review.message %></p>
        <div class="review-actions"><form method="post" action="/admin/reviews/<%= review._id %>/approve"><button class="approve" type="submit">Approve</button></form><form method="post" action="/admin/reviews/<%= review._id %>/reject"><button class="reject" type="submit">Reject</button></form></div>
      </article>
    <% }); %>
  </section>
</main>
<% if (notice === 'approved' || notice === 'rejected') { %><script>window.__toasts=[{msg:<%- JSON.stringify(notice === 'approved' ? 'Review approved and published.' : 'Review rejected.') %>,type:'success'}];</script><% } %>
<script src="/js/main.js"></script></body></html>
