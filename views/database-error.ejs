<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | POWtfolio</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="database-error-page">
    <div class="database-error-card">
      <span class="database-error-icon"><i class="fas fa-plug-circle-exclamation"></i></span>
      <p class="section-label">A quick connection check</p>
      <h1>We can’t reach the portfolio database.</h1>
      <p class="database-error-copy"><%= issue %></p>
      <a class="btn btn-primary" href="" onclick="location.reload(); return false;"><i class="fas fa-rotate-right"></i> Try again</a>
      <a class="database-error-home" href="/">Back to home</a>
    </div>
  </main>
  <script src="/js/main.js"></script>
</body>
</html>
